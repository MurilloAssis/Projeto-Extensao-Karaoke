              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fila"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoId\": \"DEVTESTE001\",\n  \"titulo\": \"Still Loving You (Karaokê)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"status na_fila e posição 1\", () => { pm.expect(r.status).to.eql(\"na_fila\"); pm.expect(r.posicao).to.eql(1); });",
                  "pm.test(\"urlVideo montada\", () => pm.expect(r.musica.urlVideo).to.eql(\"https://www.youtube.com/watch?v=DEVTESTE001\"));",
                  "pm.test(\"sem nome do solicitante\", () => pm.expect(r).to.not.have.property(\"solicitante\"));",
                  "pm.collectionVariables.set(\"pedidoAna1\", r.idFila);"
                ]
