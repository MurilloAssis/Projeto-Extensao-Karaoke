# Vazios: chamadas relativas (/api e /ws), repassadas à API pelo proxy do Vite (vite.config.js)
VITE_API_URL=
VITE_WS_URL=
# Identificação provisória do admin até o card 1.2 (perfil dev da API)
VITE_ADMIN_ID_DEV=1
# Visitante provisório até o card 1.2 (2 = Ana nos dados de desenvolvimento; trocar com /cliente?visitante=3)
VITE_VISITANTE_ID_DEV=2
# Limite de pedidos ativos (mesmo valor de KARAOKE_LIMITE_PEDIDOS na API)
VITE_LIMITE_PEDIDOS=2
