# Vazios: chamadas relativas (/api e /ws), repassadas à API pelo proxy do Vite (vite.config.js)
VITE_API_URL=
VITE_WS_URL=
# Base do link do QR Code (/cliente?sessao=<código>). Vazio: endereço do próprio painel
VITE_CLIENTE_URL=
# Limite de pedidos ativos (mesmo valor de KARAOKE_LIMITE_PEDIDOS na API)
VITE_LIMITE_PEDIDOS=2
